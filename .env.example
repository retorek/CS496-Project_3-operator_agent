# Copy to .env and fill in. Never commit .env.
# Default model provider for a new run: openai or google_genai (Gemini).
# The web page and --provider can choose the other one; its key must be set too.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Free key from Google AI Studio.
GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=internship-agent
# Email (stage 10). Gmail: an App Password (Google Account > Security > App passwords,
# needs 2-Step Verification), not the account password. Never commit .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Applications are sent HERE (an inbox you own), never to the employer.
TEST_INBOX=
# false: emails are only prepared (test mode). true: really sent to TEST_INBOX.
SEND_EMAILS=false
BATCH_SIZE=3
MAX_APPLICATIONS=3
MAX_STEPS=50
MAX_TOKENS=200000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# All model requests together, per minute (12 = one every 5 s; lower it if you get rate-limit errors)
LLM_REQUESTS_PER_MINUTE=12
# Stage 3 (find offers)
SCRAPE_DELAY=1.0
SCRAPE_TIMEOUT=15
MAX_OFFERS_PER_SEARCH=5
MAX_QUERIES=4
FIND_MAX_TOOL_CALLS=6
