# Copy to .env and fill in. Never commit .env.
# Default model provider for a new run: openai or google_genai (Gemini).
# The web page and --provider can choose the other one; its key must be set too.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Free key from Google AI Studio.
GOOGLE_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=internship-agent
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
# Applications are sent HERE, never to the employer.
TEST_INBOX=test-inbox@example.com
BATCH_SIZE=3
MAX_APPLICATIONS=3
MAX_STEPS=50
MAX_TOKENS=200000
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
